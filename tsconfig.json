{
  "compilerOptions": {
    "module": "nodenext", // 使用 ESM
    "moduleResolution": "nodenext", // 必须加
    "target": "ES2022",
    "types": ["node"], // 支持 Node 类型
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "verbatimModuleSyntax": true, // 对 ESM 强类型
    "isolatedModules": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "src/types"],
  "exclude": ["node_modules", "dist"]
}
